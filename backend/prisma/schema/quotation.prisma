model Quotation {
  id                    String            @id @default(uuid())
  quotationNumber       String            @unique
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])
  salesRepId            String
  salesRep              User              @relation("SalesRepQuotations", fields: [salesRepId], references: [id])

  status                QuotationStatus   @default(DRAFT)
  currency              String            @default("INR") @db.VarChar(3)

  subtotal              Decimal           @default(0.00) @db.Decimal(14, 2)
  discountAmount        Decimal           @default(0.00) @db.Decimal(14, 2)
  taxAmount             Decimal           @default(0.00) @db.Decimal(14, 2)
  totalAmount           Decimal           @default(0.00) @db.Decimal(14, 2)

  // Live Margin Calculation
  costAmount            Decimal           @default(0.00) @db.Decimal(14, 2)
  marginAmount          Decimal           @default(0.00) @db.Decimal(14, 2)
  marginPercentage      Decimal           @default(0.00) @db.Decimal(5, 2)

  // Discount Governance & Blended Risk
  riskScore             Decimal           @default(0.00) @db.Decimal(8, 2)
  approvalLevel         Int               @default(0)

  // Customer Portal Interaction Tracking
  customerStatus        CustomerStatus    @default(UNOPENED)
  expiresAt             DateTime?
  lastActivityAt        DateTime          @default(now())

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 QuotationItem[]
  approvals             Approval[]
  negotiations          NegotiationRequest[]
  comments              QuotationComment[]
  changeRequests        ChangeRequest[]
  order                 Order?
  dealAlerts            DealAlert[]
  upsellEvents          UpsellEvent[]

  @@index([customerId])
  @@index([salesRepId])
  @@index([status])
  @@index([quotationNumber])
}

enum QuotationStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_FINANCE
  APPROVED
  REJECTED
  UNDER_NEGOTIATION
  CONFIRMED
  CONVERTED_TO_ORDER
  EXPIRED
}

enum CustomerStatus {
  UNOPENED
  VIEWED
  COUNTER_PROPOSED
  ACCEPTED
  DECLINED
}

model QuotationItem {
  id                    String            @id @default(uuid())
  quotationId           String
  quotation             Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId             String
  product               Product           @relation(fields: [productId], references: [id])
  variantId             String?
  variant               ProductVariant?   @relation(fields: [variantId], references: [id])

  quantity              Decimal           @db.Decimal(12, 2)
  unitPrice             Decimal           @db.Decimal(12, 2)
  discountPercentage   Decimal           @default(0.00) @db.Decimal(5, 2)
  discountAmount        Decimal           @default(0.00) @db.Decimal(12, 2)
  taxRate               Decimal           @default(18.00) @db.Decimal(5, 2)
  lineTotal             Decimal           @db.Decimal(14, 2)

  // Profitability
  costPrice             Decimal           @db.Decimal(12, 2)
  marginAmount          Decimal           @db.Decimal(14, 2)
  marginPercentage      Decimal           @db.Decimal(5, 2)

  // Blended Risk Metric Components
  discountLimit         Decimal           @default(0.00) @db.Decimal(5, 2)
  discountExcess        Decimal           @default(0.00) @db.Decimal(5, 2)
  riskContribution      Decimal           @default(0.00) @db.Decimal(8, 2)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  comments              QuotationComment[]
  changeRequests        ChangeRequest[]

  @@index([quotationId])
  @@index([productId])
}

model Approval {
  id                    String            @id @default(uuid())
  quotationId           String
  quotation             Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  level                 Int               @default(1)
  approverRole          Role              @default(SALES_MANAGER)
  approverId            String?
  approver              User?             @relation("Approver", fields: [approverId], references: [id])

  status                ApprovalStatus    @default(PENDING)
  action                ApprovalAction?
  reason                String?

  requestedAt           DateTime          @default(now())
  actedAt               DateTime?

  @@index([quotationId])
  @@index([status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum ApprovalAction {
  APPROVE
  REJECT
  RETURN_FOR_REVISION
}

model AuditLog {
  id                    String            @id @default(uuid())
  entityType            String            // QUOTATION, APPROVAL, ORDER, INVOICE
  entityId              String
  action                String            // CREATED, SUBMITTED, APPROVED, COUNTERED, RE-ROUTED
  performedBy           String
  user                  User              @relation("PerformedByUser", fields: [performedBy], references: [id])

  oldValue              Json?
  newValue              Json?
  reason                String?

  createdAt             DateTime          @default(now())

  @@index([entityType, entityId])
  @@index([performedBy])
}

model NegotiationRequest {
  id                    String            @id @default(uuid())
  quotationId           String
  quotation             Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status                NegotiationStatus @default(OPEN)
  requestedDiscount     Decimal           @db.Decimal(5, 2)
  message               String?

  createdAt             DateTime          @default(now())
  resolvedAt            DateTime?

  @@index([quotationId])
}

enum NegotiationStatus {
  OPEN
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model QuotationComment {
  id                    String            @id @default(uuid())
  quotationId           String
  quotation             Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationItemId       String?
  quotationItem         QuotationItem?    @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  authorType            String            // "REP", "CUSTOMER", "MANAGER"
  authorId              String
  comment               String

  createdAt             DateTime          @default(now())

  @@index([quotationId])
}

model ChangeRequest {
  id                    String            @id @default(uuid())
  quotationId           String
  quotation             Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationItemId       String?
  quotationItem         QuotationItem?    @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  requestedQuantity     Decimal?          @db.Decimal(12, 2)
  requestedDiscount     Decimal?          @db.Decimal(5, 2)
  reason                String?
  status                NegotiationStatus @default(OPEN)

  createdAt             DateTime          @default(now())
  resolvedAt            DateTime?

  @@index([quotationId])
}
