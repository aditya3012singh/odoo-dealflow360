model SubscriptionPlan {
  id                    String            @id @default(uuid())
  name                  String            @unique // "Standard Monthly Support", "Enterprise Annual License"
  billingInterval       BillingInterval   @default(MONTHLY)
  price                 Decimal           @db.Decimal(12, 2)
  prorationEnabled      Boolean           @default(true)
  refundEnabled         Boolean           @default(false)
  createdAt             DateTime          @default(now())

  subscriptions         Subscription[]
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Subscription {
  id                    String              @id @default(uuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId             String
  product               Product             @relation(fields: [productId], references: [id])
  planId                String
  plan                  SubscriptionPlan    @relation(fields: [planId], references: [id])

  quantity              Decimal             @default(1.00) @db.Decimal(12, 2)
  status                SubscriptionStatus  @default(ACTIVE)

  currentPeriodStart    DateTime            @default(now())
  currentPeriodEnd      DateTime
  nextBillingDate       DateTime

  createdAt             DateTime            @default(now())
  cancelledAt           DateTime?

  billingSchedules      BillingSchedule[]
  invoiceItems          InvoiceItem[]

  @@index([customerId])
  @@index([nextBillingDate])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model BillingSchedule {
  id                    String                  @id @default(uuid())
  subscriptionId        String
  subscription          Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  billingDate           DateTime
  amount                Decimal                 @db.Decimal(14, 2)
  status                BillingScheduleStatus   @default(SCHEDULED)

  paidAt                DateTime?
  createdAt             DateTime                @default(now())

  @@index([subscriptionId])
  @@index([billingDate, status])
}

enum BillingScheduleStatus {
  SCHEDULED
  INVOICED
  PAID
  FAILED
  CANCELLED
}

model Invoice {
  id                    String            @id @default(uuid())
  invoiceNumber         String            @unique
  orderId               String
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  invoiceType           InvoiceType       @default(ONE_TIME)
  subtotal              Decimal           @db.Decimal(14, 2)
  taxAmount             Decimal           @db.Decimal(14, 2)
  totalAmount           Decimal           @db.Decimal(14, 2)
  paidAmount            Decimal           @default(0.00) @db.Decimal(14, 2) // Increments per payment

  status                InvoiceStatus     @default(ISSUED)
  dueDate               DateTime
  issuedAt              DateTime          @default(now())
  paidAt                DateTime?

  items                 InvoiceItem[]
  payments              Payment[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
}

enum InvoiceType {
  ONE_TIME
  RECURRING
  PRORATION
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

model InvoiceItem {
  id                    String            @id @default(uuid())
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId             String
  product               Product           @relation(fields: [productId], references: [id])
  subscriptionId        String?
  subscription          Subscription?     @relation(fields: [subscriptionId], references: [id])

  description           String
  quantity              Decimal           @db.Decimal(12, 2)
  unitPrice             Decimal           @db.Decimal(12, 2)
  discountAmount        Decimal           @default(0.00) @db.Decimal(12, 2)
  taxAmount             Decimal           @default(0.00) @db.Decimal(12, 2)
  lineTotal             Decimal           @db.Decimal(14, 2)

  @@index([invoiceId])
}

model Payment {
  id                    String            @id @default(uuid())
  invoiceId             String
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount                Decimal           @db.Decimal(14, 2)
  paymentMethod         String            @default("STRIPE_CARD") // CARD, WIRE, UPI, ACH
  status                PaymentStatus     @default(SUCCESS)
  transactionRef        String?

  paidAt                DateTime          @default(now())
  createdAt             DateTime          @default(now())

  @@index([invoiceId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
