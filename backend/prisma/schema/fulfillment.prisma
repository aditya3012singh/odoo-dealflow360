model Order {
  id                    String            @id @default(uuid())
  orderNumber           String            @unique
  quotationId           String            @unique
  quotation             Quotation         @relation(fields: [quotationId], references: [id])
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])

  status                OrderStatus       @default(PENDING_FULFILLMENT)

  subtotal              Decimal           @db.Decimal(14, 2)
  discountAmount        Decimal           @db.Decimal(14, 2)
  taxAmount             Decimal           @db.Decimal(14, 2)
  totalAmount           Decimal           @db.Decimal(14, 2)

  confirmedAt           DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 OrderItem[]       // Immutable snapshot of confirmed QuotationItems
  fulfillments          Fulfillment[]
  backorders            Backorder[]
  subscriptions         Subscription[]
  invoices              Invoice[]
  dealAlerts            DealAlert[]

  @@index([customerId])
  @@index([orderNumber])
}

// Immutable snapshot of QuotationItem at the moment the customer confirms the order.
// This decouples order/fulfillment from any future changes to the Quotation.
model OrderItem {
  id                    String            @id @default(uuid())
  orderId               String
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String
  product               Product           @relation(fields: [productId], references: [id])

  quantity              Decimal           @db.Decimal(12, 2)
  unitPrice             Decimal           @db.Decimal(12, 2)
  discountAmount        Decimal           @default(0.00) @db.Decimal(12, 2)
  taxAmount             Decimal           @default(0.00) @db.Decimal(12, 2)
  lineTotal             Decimal           @db.Decimal(14, 2)
  costPrice             Decimal           @db.Decimal(12, 2)

  createdAt             DateTime          @default(now())

  fulfillmentItems      FulfillmentItem[]

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING_FULFILLMENT
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model Warehouse {
  id                    String            @id @default(uuid())
  name                  String            @unique // e.g. "Main Central Hub", "East Depot"
  location              String            // City / Region
  shippingWeight        Decimal           @default(1.00) @db.Decimal(8, 2) // Freight cost weighting
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())

  inventory             Inventory[]
  fulfillments          Fulfillment[]
}

model Inventory {
  id                    String            @id @default(uuid())
  warehouseId           String
  warehouse             Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId             String
  product               Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  availableQty          Decimal           @default(0.00) @db.Decimal(12, 2)
  reservedQty           Decimal           @default(0.00) @db.Decimal(12, 2) // Locked for confirmed orders
  reorderLevel          Decimal           @default(10.00) @db.Decimal(12, 2)
  updatedAt             DateTime          @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([warehouseId])
}

model Fulfillment {
  id                    String            @id @default(uuid())
  orderId               String
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId           String
  warehouse             Warehouse         @relation(fields: [warehouseId], references: [id])

  status                FulfillmentStatus @default(ALLOCATED)
  shipmentNumber        String?           @unique
  estimatedCost         Decimal           @default(0.00) @db.Decimal(12, 2)

  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 FulfillmentItem[]

  @@index([orderId])
  @@index([warehouseId])
}

enum FulfillmentStatus {
  ALLOCATED
  PICKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model FulfillmentItem {
  id                    String            @id @default(uuid())
  fulfillmentId         String
  fulfillment           Fulfillment       @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId           String?           // Links back to the immutable OrderItem snapshot
  orderItem             OrderItem?        @relation(fields: [orderItemId], references: [id])
  productId             String
  quantity              Decimal           @db.Decimal(12, 2)

  @@index([fulfillmentId])
  @@index([orderItemId])
}

model Backorder {
  id                    String            @id @default(uuid())
  orderId               String
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String
  product               Product           @relation(fields: [productId], references: [id])

  quantity              Decimal           @db.Decimal(12, 2)
  fulfilledQty          Decimal           @default(0.00) @db.Decimal(12, 2)
  status                BackorderStatus   @default(OPEN)

  createdAt             DateTime          @default(now())
  fulfilledAt           DateTime?

  @@index([orderId])
  @@index([productId])
}

enum BackorderStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}
