model Category {
  id               String            @id @default(uuid())
  name             String            @unique // Hardware, Software, Services, Subscriptions
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  products         Product[]
  discountPolicies DiscountPolicy[]
}

model Product {
  id               String            @id @default(uuid())
  sku              String            @unique
  name             String
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  description      String?
  basePrice        Decimal           @db.Decimal(12, 2)
  costPrice        Decimal           @db.Decimal(12, 2) // Crucial for live gross margin calculation
  unit             String            @default("unit")   // unit, hour, month, license
  taxRate          Decimal           @default(18.00) @db.Decimal(5, 2)
  isRecurring      Boolean           @default(false)    // true for subscription items
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  variants         ProductVariant[]
  priceListItems   PriceListItem[]
  inventory        Inventory[]
  quotationItems   QuotationItem[]
  subscriptions    Subscription[]
  invoiceItems     InvoiceItem[]
  backorders       Backorder[]
  
  // Recommendations
  recommendationsAsSource ProductRelationship[] @relation("SourceProduct")
  recommendationsAsTarget ProductRelationship[] @relation("TargetProduct")
  promotions              PromotionProduct[]
  upsellEvents            UpsellEvent[]

  @@index([categoryId])
  @@index([sku])
  @@index([isRecurring])
}

model ProductVariant {
  id               String            @id @default(uuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeName    String            // e.g. "RAM", "Storage", "SLA Level"
  attributeValue   String            // e.g. "32GB", "1TB SSD", "24/7 Premium"
  extraPrice       Decimal           @default(0.00) @db.Decimal(12, 2)
  sku              String?

  quotationItems   QuotationItem[]

  @@index([productId])
}

model PriceList {
  id               String            @id @default(uuid())
  name             String
  customerTierId   String?
  customerTier     CustomerTier?     @relation(fields: [customerTierId], references: [id])
  currency         String            @default("INR") @db.VarChar(3)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            PriceListItem[]
}

model PriceListItem {
  id               String            @id @default(uuid())
  priceListId      String
  priceList        PriceList         @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  price            Decimal           @db.Decimal(12, 2)
  validFrom        DateTime          @default(now())
  validUntil       DateTime?

  @@unique([priceListId, productId])
}

model ProductRelationship {
  id                    String              @id @default(uuid())
  productId             String
  product               Product             @relation("SourceProduct", fields: [productId], references: [id], onDelete: Cascade)
  recommendedProductId  String
  recommendedProduct    Product             @relation("TargetProduct", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  relationshipType      RelationshipType    @default(UPSELL)
  score                 Decimal             @default(0.8500) @db.Decimal(8, 4)
  createdAt             DateTime            @default(now())

  @@unique([productId, recommendedProductId])
  @@index([productId])
}

enum RelationshipType {
  UPSELL
  CROSS_SELL
}

model Promotion {
  id                  String              @id @default(uuid())
  name                String
  discountPercentage Decimal             @db.Decimal(5, 2)
  startsAt            DateTime
  endsAt              DateTime
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())

  products            PromotionProduct[]
}

model PromotionProduct {
  id                  String              @id @default(uuid())
  promotionId         String
  promotion           Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
}

model UpsellEvent {
  id                  String              @id @default(uuid())
  quotationId         String
  quotation           Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  action              UpsellAction        @default(SHOWN)
  marginDelta         Decimal             @default(0.00) @db.Decimal(12, 2)
  createdAt           DateTime            @default(now())

  @@index([quotationId])
}

enum UpsellAction {
  SHOWN
  ADDED
  DISMISSED
}
